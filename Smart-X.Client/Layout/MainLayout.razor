@inherits LayoutComponentBase
@inject Smart_X.Client.Services.LiveDataService LiveData

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    // Idempotent: the poller starts once and keeps running while the operator moves between modules.
    protected override void OnInitialized() => LiveData.Start();
}
