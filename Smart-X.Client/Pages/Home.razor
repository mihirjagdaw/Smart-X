@page "/"
@inject NavigationManager Navigation

<PageTitle>Smart-X Vineyard Gateway</PageTitle>

<h1 class="mb-4">Smart-X Vineyard Gateway</h1>

<div class="d-flex flex-column gap-3" style="max-width: 640px;">

    <div class="card border-primary" style="cursor: pointer;" @onclick='() => Navigation.NavigateTo("/ingestion")'>
        <div class="card-body">
            <h5 class="card-title">Sensor Data Ingestion and Telemetry</h5>
            <p class="card-text text-muted mb-0">Register vineyard sensors and monitor soil moisture, canopy temperature, and irrigation actuators in real time.</p>
        </div>
    </div>

    <div class="card border-primary" style="cursor: pointer;" @onclick='() => Navigation.NavigateTo("/command-stream")'>
        <div class="card-body">
            <h5 class="card-title">Real-Time Command Stream and History</h5>
            <p class="card-text text-muted mb-0">Watch readings arrive, find devices fast, send override commands with undo, and see suggested actions before you go looking for them.</p>
        </div>
    </div>

    <div class="card bg-light" style="cursor: pointer;" @onclick='() => Navigation.NavigateTo("/topology")'>
        <div class="card-body">
            <h5 class="card-title">Network Topology and Mesh Routing</h5>
            <p class="card-text text-muted mb-0">To be implemented in the final PoE.</p>
        </div>
    </div>

</div>
