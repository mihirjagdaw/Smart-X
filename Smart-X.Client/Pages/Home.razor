@page "/"
@inject NavigationManager Navigation

<PageTitle>Smart-X Gateway</PageTitle>

<h1 class="mb-4">Smart-X Gateway</h1>

<div class="d-flex flex-column gap-3" style="max-width: 640px;">

    <div class="card border-primary" style="cursor: pointer;" @onclick='() => Navigation.NavigateTo("/ingestion")'>
        <div class="card-body">
            <h5 class="card-title">Sensor Data Ingestion and Telemetry</h5>
            <p class="card-text text-muted mb-0">Register sensors and ingest live telemetry readings.</p>
        </div>
    </div>

    <div class="card bg-light text-muted">
        <div class="card-body">
            <h5 class="card-title">Real-Time Command Stream and History</h5>
            <p class="card-text mb-0">To be implemented in Part 2.</p>
        </div>
    </div>

    <div class="card bg-light text-muted">
        <div class="card-body">
            <h5 class="card-title">Network Topology and Mesh Routing</h5>
            <p class="card-text mb-0">To be implemented in the final PoE.</p>
        </div>
    </div>

</div>
