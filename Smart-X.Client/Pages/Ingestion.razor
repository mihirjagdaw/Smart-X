@page "/ingestion"
@using System.Net.Http.Json
@using Smart_X.Shared
@using Smart_X.Shared.DTOs
@using Smart_X.Client.Models
@inject HttpClient Http

<PageTitle>Sensor Ingestion</PageTitle>

<h1 class="mb-4">Sensor Data Ingestion and Telemetry</h1>

<div class="row mb-4">
    <div class="col-md-6 mb-4 mb-md-0">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Register Sensor</h5>

                <EditForm Model="@sensorForm" OnValidSubmit="RegisterSensor">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">MAC Address</label>
                        <InputText @bind-Value="sensorForm.MacAddress" class="form-control" placeholder="AA:BB:CC:DD:EE:FF" />
                        <ValidationMessage For="@(() => sensorForm.MacAddress)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Location</label>
                        <InputText @bind-Value="sensorForm.Location" class="form-control" placeholder="e.g. Greenhouse Zone 1" />
                        <ValidationMessage For="@(() => sensorForm.Location)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <InputSelect @bind-Value="sensorForm.Category" class="form-select">
                            @foreach (var category in Enum.GetValues<SensorCategory>())
                            {
                                <option value="@category">@category</option>
                            }
                        </InputSelect>
                    </div>

                    <button type="submit" class="btn btn-primary" disabled="@isRegisteringSensor">
                        @(isRegisteringSensor ? "Registering..." : "Register Sensor")
                    </button>
                </EditForm>

                @if (sensorSubmitError is not null)
                {
                    <div class="alert alert-danger mt-3">@sensorSubmitError</div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Ingest Telemetry</h5>

                <EditForm Model="@telemetryForm" OnValidSubmit="IngestTelemetry">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Device</label>
                        <InputSelect @bind-Value="telemetryForm.DeviceId" @bind-Value:after="LoadHistory" class="form-select">
                            <option value="">-- select a device --</option>
                            @foreach (var sensor in sensors)
                            {
                                <option value="@sensor.MacAddress">@sensor.MacAddress (@sensor.Location)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => telemetryForm.DeviceId)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Value Type</label>
                        <InputSelect @bind-Value="telemetryForm.ValueType" class="form-select">
                            <option value="float">Float</option>
                            <option value="int">Int</option>
                            <option value="bool">Bool</option>
                        </InputSelect>
                    </div>

                    @if (telemetryForm.ValueType == "float")
                    {
                        <div class="mb-3">
                            <label class="form-label">Value</label>
                            <InputNumber @bind-Value="telemetryForm.FloatValue" class="form-control" />
                        </div>
                    }
                    else if (telemetryForm.ValueType == "int")
                    {
                        <div class="mb-3">
                            <label class="form-label">Value</label>
                            <InputNumber @bind-Value="telemetryForm.IntValue" class="form-control" />
                        </div>
                    }
                    else
                    {
                        <div class="mb-3 form-check">
                            <InputCheckbox @bind-Value="telemetryForm.BoolValue" class="form-check-input" id="boolValue" />
                            <label class="form-check-label" for="boolValue">Value (on/off)</label>
                        </div>
                    }

                    @if (telemetryValueError is not null)
                    {
                        <div class="alert alert-danger">@telemetryValueError</div>
                    }

                    <button type="submit" class="btn btn-primary" disabled="@isIngestingTelemetry">
                        @(isIngestingTelemetry ? "Sending..." : "Send Reading")
                    </button>
                </EditForm>

                @if (telemetrySubmitError is not null)
                {
                    <div class="alert alert-danger mt-3">@telemetrySubmitError</div>
                }

                @if (!string.IsNullOrEmpty(telemetryForm.DeviceId))
                {
                    <hr />
                    <h6>History for @telemetryForm.DeviceId</h6>
                    @if (isLoadingHistory)
                    {
                        <p class="text-muted">Loading...</p>
                    }
                    else if (history.Count == 0)
                    {
                        <p class="text-muted">No readings yet.</p>
                    }
                    else
                    {
                        <ul class="list-group" style="max-height: 200px; overflow-y: auto;">
                            @foreach (var reading in history)
                            {
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>@reading.Value</span>
                                    <span class="text-muted">@reading.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                                </li>
                            }
                        </ul>
                    }
                }
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Attach Files</h5>

        <div class="mb-3">
            <label class="form-label">Device</label>
            <select class="form-select" @bind="fileDeviceId" @bind:after="LoadAttachedFiles">
                <option value="">-- select a device --</option>
                @foreach (var sensor in sensors)
                {
                    <option value="@sensor.MacAddress">@sensor.MacAddress (@sensor.Location)</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <InputFile OnChange="OnFileSelected" class="form-control" />
        </div>

        @if (fileUploadError is not null)
        {
            <div class="alert alert-danger">@fileUploadError</div>
        }

        <button type="button" class="btn btn-primary" disabled="@(isUploadingFile || selectedFile is null)" @onclick="UploadFile">
            @(isUploadingFile ? "Uploading..." : "Upload")
        </button>

        @if (!string.IsNullOrEmpty(fileDeviceId))
        {
            <hr />
            <h6>Files for @fileDeviceId</h6>
            @if (isLoadingFiles)
            {
                <p class="text-muted">Loading...</p>
            }
            else if (attachedFiles.Count == 0)
            {
                <p class="text-muted">No files attached yet.</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var file in attachedFiles)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@file.FileName <span class="text-muted">(@FormatFileSize(file.SizeBytes))</span></span>
                            <a class="btn btn-sm btn-outline-secondary" href="@GetFileUrl(file.Id)" target="_blank">Download</a>
                        </li>
                    }
                </ul>
            }
        }
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Registered Sensors</h5>

        @if (isLoadingSensors)
        {
            <p class="text-muted">Loading sensors...</p>
        }
        else if (sensorLoadError is not null)
        {
            <div class="alert alert-danger">@sensorLoadError</div>
        }
        else if (sensors.Count == 0)
        {
            <p class="text-muted">No sensors registered yet.</p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>MAC Address</th>
                        <th>Location</th>
                        <th>Category</th>
                        <th>Registered</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sensor in sensors)
                    {
                        <tr>
                            <td>@sensor.MacAddress</td>
                            <td>@sensor.Location</td>
                            <td>@sensor.Category</td>
                            <td>@sensor.RegisteredAt.ToLocalTime().ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private SensorFormModel sensorForm = new();
    private TelemetryFormModel telemetryForm = new();

    private List<SensorProfileResponse> sensors = new();
    private List<SensorReadingResponse> history = new();

    private bool isLoadingSensors = true;
    private bool isRegisteringSensor = false;
    private bool isIngestingTelemetry = false;
    private bool isLoadingHistory = false;

    private string? sensorSubmitError;
    private string? sensorLoadError;
    private string? telemetrySubmitError;
    private string? telemetryValueError;

    private const string ApiBaseUrl = "http://localhost:5256";
    private const long MaxFileSizeBytes = 5 * 1024 * 1024;

    private string fileDeviceId = "";
    private IBrowserFile? selectedFile;
    private List<SensorFileResponse> attachedFiles = new();
    private bool isUploadingFile = false;
    private bool isLoadingFiles = false;
    private string? fileUploadError;

    protected override async Task OnInitializedAsync()
    {
        await LoadSensors();
    }

    private async Task LoadSensors()
    {
        isLoadingSensors = true;
        sensorLoadError = null;
        try
        {
            sensors = await Http.GetFromJsonAsync<List<SensorProfileResponse>>("api/Sensors") ?? new();
        }
        catch (Exception ex)
        {
            sensorLoadError = $"Failed to load sensors: {ex.Message}";
        }
        finally
        {
            isLoadingSensors = false;
        }
    }

    private async Task RegisterSensor()
    {
        isRegisteringSensor = true;
        sensorSubmitError = null;
        try
        {
            var request = new CreateSensorRequest(sensorForm.MacAddress, sensorForm.Location, sensorForm.Category);
            var response = await Http.PostAsJsonAsync("api/Sensors", request);

            if (response.IsSuccessStatusCode)
            {
                sensorForm = new SensorFormModel();
                await LoadSensors();
            }
            else
            {
                sensorSubmitError = $"Registration failed: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            sensorSubmitError = $"Registration failed: {ex.Message}";
        }
        finally
        {
            isRegisteringSensor = false;
        }
    }

    private async Task IngestTelemetry()
    {
        telemetryValueError = null;

        if (telemetryForm.ValueType == "float" && telemetryForm.FloatValue is null)
        {
            telemetryValueError = "Please enter a value.";
            return;
        }
        if (telemetryForm.ValueType == "int" && telemetryForm.IntValue is null)
        {
            telemetryValueError = "Please enter a value.";
            return;
        }

        var selectedSensor = sensors.FirstOrDefault(s => s.MacAddress == telemetryForm.DeviceId);
        if (selectedSensor is null)
        {
            telemetryValueError = "Selected device not found.";
            return;
        }

        isIngestingTelemetry = true;
        telemetrySubmitError = null;
        try
        {
            var request = new TelemetryIngestRequest(
                telemetryForm.DeviceId,
                selectedSensor.Category,
                telemetryForm.ValueType,
                telemetryForm.ValueType == "float" ? telemetryForm.FloatValue : null,
                telemetryForm.ValueType == "int" ? telemetryForm.IntValue : null,
                telemetryForm.ValueType == "bool" ? telemetryForm.BoolValue : null);

            var response = await Http.PostAsJsonAsync("api/Telemetry", request);

            if (response.IsSuccessStatusCode)
            {
                await LoadHistory();
            }
            else
            {
                telemetrySubmitError = $"Ingestion failed: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            telemetrySubmitError = $"Ingestion failed: {ex.Message}";
        }
        finally
        {
            isIngestingTelemetry = false;
        }
    }

    private async Task LoadHistory()
    {
        if (string.IsNullOrEmpty(telemetryForm.DeviceId))
        {
            history = new();
            return;
        }

        isLoadingHistory = true;
        try
        {
            history = await Http.GetFromJsonAsync<List<SensorReadingResponse>>($"api/Telemetry/{telemetryForm.DeviceId}") ?? new();
        }
        catch
        {
            history = new();
        }
        finally
        {
            isLoadingHistory = false;
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        fileUploadError = null;
    }

    private static string FormatFileSize(long sizeBytes) =>
        sizeBytes < 1024 ? $"{sizeBytes} B" : $"{sizeBytes / 1024.0:0.#} KB";

    private string GetFileUrl(int fileId)
    {
        var sensorId = sensors.FirstOrDefault(s => s.MacAddress == fileDeviceId)?.Id;
        return $"{ApiBaseUrl}/api/Sensors/{sensorId}/files/{fileId}";
    }

    private async Task UploadFile()
    {
        fileUploadError = null;

        var selectedSensor = sensors.FirstOrDefault(s => s.MacAddress == fileDeviceId);
        if (selectedSensor is null)
        {
            fileUploadError = "Please select a device.";
            return;
        }

        if (selectedFile is null)
        {
            fileUploadError = "Please choose a file.";
            return;
        }

        if (selectedFile.Size > MaxFileSizeBytes)
        {
            fileUploadError = "File exceeds the 5 MB limit.";
            return;
        }

        isUploadingFile = true;
        try
        {
            using var content = new MultipartFormDataContent();
            using var fileStream = selectedFile.OpenReadStream(MaxFileSizeBytes);
            using var streamContent = new StreamContent(fileStream);
            var contentType = string.IsNullOrEmpty(selectedFile.ContentType) ? "application/octet-stream" : selectedFile.ContentType;
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(contentType);
            content.Add(streamContent, "file", selectedFile.Name);

            var response = await Http.PostAsync($"api/Sensors/{selectedSensor.Id}/files", content);

            if (response.IsSuccessStatusCode)
            {
                selectedFile = null;
                await LoadAttachedFiles();
            }
            else
            {
                fileUploadError = $"Upload failed: {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex)
        {
            fileUploadError = $"Upload failed: {ex.Message}";
        }
        finally
        {
            isUploadingFile = false;
        }
    }

    private async Task LoadAttachedFiles()
    {
        var selectedSensor = sensors.FirstOrDefault(s => s.MacAddress == fileDeviceId);
        if (selectedSensor is null)
        {
            attachedFiles = new();
            return;
        }

        isLoadingFiles = true;
        try
        {
            attachedFiles = await Http.GetFromJsonAsync<List<SensorFileResponse>>($"api/Sensors/{selectedSensor.Id}/files") ?? new();
        }
        catch
        {
            attachedFiles = new();
        }
        finally
        {
            isLoadingFiles = false;
        }
    }
}
