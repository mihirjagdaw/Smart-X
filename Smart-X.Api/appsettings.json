{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SmartXDb": "Data Source=smartx.db"
  },
  "Simulator": {
    "ApiBaseUrl": "http://localhost:5256"
  },
  "Processing": {
    "StandardDelayMs": 100
  },
  "Monitor": {
    "DisconnectAfterSeconds": 15
  },
  "History": {
    "RetentionDays": 30
  },
  "Mesh": {
    "SpacingMetres": 40,
    "RadioRangeMetres": 80,
    "ElectronicsNjPerBit": 50,
    "AmplifierNjPerBitPerSquareMetre": 0.1
  }
}
